{
  "cli": {
    "appVersionSource": "local",
    "requireCommit": true
  },
  "build": {
    "development": {
      "node": "20.18.0",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EAS_BUILD_ENV": "development"
      }
    },
    "preview": {
      "node": "20.18.0",
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "env": {
        "EAS_BUILD_ENV": "preview"
      }
    },
    "production": {
      "node": "20.18.0",
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": false,
      "env": {
        "EAS_BUILD_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./play-store-key.json",
        "track": "internal"
      }
    }
  }
}
