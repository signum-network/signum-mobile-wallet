      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.2"
      },
      "env": {
        "EAS_BUILD_ENV": "development"
      }
    },
    "preview": {
      "node": "22.11.0",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.2"
      },
      "distribution": "internal",
      "env": {
        "EAS_BUILD_ENV": "preview"
      }
    },
    "production": {
      "node": "22.11.0",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.2"
